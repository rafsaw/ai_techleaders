{
  "name": "@devmentor/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./backend/api/*": "./src/backend/api/*.ts",
    "./backend/forms/*": "./src/backend/forms/*.tsx",
    "./backend/tables/*": "./src/backend/tables/*.tsx",
    "./backend/feedback/*": "./src/backend/feedback/*.tsx",
    "./forms/*": "./src/forms/*.ts",
    "./frontend/*": "./src/frontend/*.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "test:storybook:themes": "STORYBOOK_THEME=light npm run test:storybook && STORYBOOK_THEME=dark npm run test:storybook",
    "check:tokens": "node scripts/check-tokens.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.56.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-themes": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitest/browser-playwright": "^5.0.5",
    "msw": "^3.0.3",
    "msw-storybook-addon": "^3.0.3",
    "playwright": "^1.64.1",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.3",
    "vite": "^8.3.4",
    "zod": "^4.6.7"
  }
}
