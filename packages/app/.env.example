# Copy to .env and adjust. Read by Next.js and by the MikroORM CLI
# (packages/db/mikro-orm.config.ts loads env files from this directory).
DATABASE_URL=postgres://devmentor:devmentor@127.0.0.1:5432/devmentor
DB_POOL_MIN=0
DB_POOL_MAX=10
# Log SQL queries
DB_DEBUG=false

# Public origin of the app; absolute links and redirects are built from it.
# Use https in production.
APP_URL=http://localhost:3000

# GitHub sign-in: create a GitHub OAuth App (see README, "Configure env") with
# the callback URL http://localhost:3000/api/auth/github/callback.
# Only GitHub sign-in needs these; the app boots without them.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional endpoint overrides, used by integration tests to point at a stub.
# GITHUB_OAUTH_URL=https://github.com
# GITHUB_API_URL=https://api.github.com

# Outbound email (confirmation links). Local dev uses Mailpit from
# docker-compose.yml: SMTP on 1025, inbox at http://localhost:8025.
# Only sending mail needs these; the app boots without them.
# Production: smtps://user:password@smtp.example.com:465 (or smtp:// with STARTTLS).
SMTP_URL=smtp://localhost:1025
MAIL_FROM="DevMentor <no-reply@localhost>"
